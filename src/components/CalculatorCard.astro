---
import type { CalculatorItem } from '../data/calculators';
type Props = { item: CalculatorItem; compact?: boolean };
const { item, compact = false } = Astro.props;
---

<a class:list={['calculator-card', `accent-${item.accent}`, { compact }]} href={item.path} data-calculator-card data-search={`${item.name} ${item.summary} ${item.category}`}>
  <span class:list={['card-scene', { 'card-scene--reference': item.sceneKind === 'reference' }]} style={`background-image: url('${item.scene}')`} aria-hidden="true">
    <span class="card-icon">{item.icon}</span>
  </span>
  <span class="card-copy">
    <strong>{item.shortName}</strong>
    <span>{item.summary}</span>
  </span>
  <span class="card-arrow" aria-hidden="true">›</span>
</a>

<style>
  .calculator-card {
    --accent: var(--primary);
    position: relative;
    display: grid;
    grid-template-columns: 86px 1fr auto;
    gap: 14px;
    min-height: 124px;
    align-items: center;
    padding: 18px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .calculator-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--accent);
    content: '';
  }

  .calculator-card:hover {
    border-color: color-mix(in srgb, var(--accent) 54%, var(--border));
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .accent-gold { --accent: var(--secondary); }
  .accent-coral { --accent: var(--coral); }
  .accent-blue { --accent: var(--blue); }
  .accent-violet { --accent: var(--violet); }
  .accent-green { --accent: var(--green); }

  .card-scene {
    position: relative;
    width: 86px;
    aspect-ratio: 1.12;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: 18px;
    background-color: var(--bg-soft);
    background-position: center;
    background-size: cover;
    box-shadow: inset 0 -22px 28px -22px rgba(3, 18, 36, 0.65);
  }

  .card-scene--reference {
    background-position: 8% 42%;
    background-size: 265% auto;
  }

  .card-icon {
    position: absolute;
    right: -7px;
    bottom: -8px;
    display: grid;
    width: 34px;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid var(--surface);
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 23%, var(--surface));
    box-shadow: var(--shadow-sm);
    font-size: 1.15rem;
  }

  .card-copy {
    display: grid;
    gap: 3px;
  }

  .card-copy strong {
    font-size: 1.06rem;
    letter-spacing: -0.02em;
  }

  .card-copy span {
    color: var(--text-soft);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .card-arrow {
    color: var(--accent);
    font-size: 1.8rem;
  }

  .compact {
    min-height: 104px;
    grid-template-columns: 72px 1fr auto;
  }

  .compact .card-scene { width: 72px; border-radius: 15px; }
  .compact .card-icon { width: 30px; font-size: 1rem; }

  @media (max-width: 440px) {
    .calculator-card { grid-template-columns: 72px 1fr auto; padding: 14px; }
    .card-scene { width: 72px; }
  }
</style>
