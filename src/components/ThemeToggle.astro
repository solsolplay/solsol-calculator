<button class="theme-toggle" type="button" data-theme-toggle aria-label="밤 모드로 전환" aria-pressed="false">
  <span class="theme-toggle__sun" aria-hidden="true">☀ <b>낮</b></span>
  <span class="theme-toggle__moon" aria-hidden="true">☾ <b>밤</b></span>
  <span class="visually-hidden" data-theme-label>테마 전환</span>
</button>

<script>
  function syncThemeButton(button: HTMLButtonElement) {
    const night = document.documentElement.dataset.theme === 'night';
    button.setAttribute('aria-pressed', String(night));
    button.setAttribute('aria-label', night ? '낮 모드로 전환' : '밤 모드로 전환');
    const label = button.querySelector<HTMLElement>('[data-theme-label]');
    if (label) label.textContent = night ? '현재 밤 모드' : '현재 낮 모드';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    syncThemeButton(button);
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'night' ? 'day' : 'night';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('solsol-theme', next); } catch { /* 저장 불가 시 현재 화면만 변경 */ }
      syncThemeButton(button);
    });
  });
</script>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    width: 116px;
    height: 42px;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    overflow: hidden;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    color: white;
    background: #142748;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }

  .theme-toggle::before {
    position: absolute;
    z-index: 0;
    top: 3px;
    left: 3px;
    width: 54px;
    height: 34px;
    border-radius: 999px;
    background: linear-gradient(135deg, #10a8ee, #2477ee);
    box-shadow: 0 3px 12px rgba(12, 139, 231, 0.38);
    transition: transform 180ms ease;
    content: '';
  }

  .theme-toggle span[aria-hidden='true'] {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    opacity: 0.58;
    font-size: 1rem;
    transition: opacity 180ms ease;
  }

  .theme-toggle b { font-size: 0.83rem; }
  .theme-toggle__sun { opacity: 1 !important; }

  :global(html[data-theme='night']) .theme-toggle::before { transform: translateX(56px); }
  :global(html[data-theme='night']) .theme-toggle__sun { opacity: 0.58 !important; }
  :global(html[data-theme='night']) .theme-toggle__moon { opacity: 1; }
</style>
