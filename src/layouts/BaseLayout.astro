---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = siteConfig.name,
  description = siteConfig.description,
  noindex = false,
  schema,
} = Astro.props;
const fullTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url).href;
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
};
const isHome = Astro.url.pathname === '/';
const isCalculator = Astro.url.pathname.startsWith('/calculators/');
const pageClass = isHome ? 'page-home page-world' : isCalculator ? 'page-calculator page-world' : undefined;
---

<!doctype html>
<html lang="ko" data-theme="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#079b91" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteConfig.url}/images/backgrounds/solsol-world-day.webp`} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="941" />
    <meta property="og:image:alt" content="밝은 계산 정원에 모인 솔솔계산소 12지신 도우미" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('solsol-theme');
          const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
          document.documentElement.dataset.theme = saved === 'day' || saved === 'night' ? saved : system;
        } catch {
          document.documentElement.dataset.theme = 'day';
        }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ?? defaultSchema)}></script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
