---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import { getCalculator } from '../../data/calculators';
import { sources } from '../../data/sources';
const calculator = getCalculator('age');
---

<CalculatorLayout calculator={calculator}
  formula="기준 연도에서 출생 연도를 뺀 뒤, 기준일에 올해 생일이 아직 오지 않았다면 1을 뺍니다."
  example="2000년 8월 21일생을 2026년 8월 20일 기준으로 계산하면 올해 생일 전이므로 만 25세입니다."
  caveats={["생년월일이 기준일보다 늦으면 계산하지 않습니다.", "2월 29일생의 비윤년 생일은 날짜 계산상 3월 1일로 처리합니다.", "특별법에서 연 나이를 따로 정한 경우에는 해당 법령을 확인해야 합니다."]}
  sources={[sources.ageLaw, sources.ageGuide]} version="1.1.0">
  <section slot="form" class="calculator-panel">
    <h2>생년월일과 기준일 입력</h2>
    <form id="age-form" novalidate>
      <div class="field-grid">
        <div class="field"><label for="birth-year">생년</label><input id="birth-year" inputmode="numeric" type="number" min="1" max="9999" placeholder="예: 2000" required /></div>
        <div class="field"><label for="birth-month">생월</label><input id="birth-month" inputmode="numeric" type="number" min="1" max="12" placeholder="예: 8" required /></div>
        <div class="field"><label for="birth-day">생일</label><input id="birth-day" inputmode="numeric" type="number" min="1" max="31" placeholder="예: 21" required /></div>
        <div class="field"><label for="age-base-date">기준일</label><input id="age-base-date" type="date" required /><small>오늘이 아니라 원하는 날짜로 바꿀 수 있어요.</small></div>
      </div>
      <div class="form-actions"><button class="button" type="submit">계산하기</button><button class="button secondary" type="reset">초기화</button></div>
      <p id="age-error" class="error-message" role="alert"></p>
    </form>
  </section>
  <section slot="result" class="result-panel" aria-labelledby="age-result-title">
    <h2 id="age-result-title">계산 결과</h2>
    <div id="age-empty" class="result-empty">생년월일을 입력하면 만 나이와 다음 생일까지 남은 날을 보여드려요.</div>
    <div id="age-content" class="result-content" hidden aria-live="polite">
      <div class="result-primary"><span class="label">기준일의 만 나이</span><strong id="age-result" data-testid="age-result"></strong></div>
      <dl class="result-list"><div><dt>살아온 날짜</dt><dd id="age-days-lived"></dd></div><div><dt>다음 생일까지</dt><dd id="age-days-until"></dd></div><div><dt>다음 생일</dt><dd id="age-next-birthday"></dd></div></dl>
    </div>
  </section>
</CalculatorLayout>

<script>
  import { calculateAge } from '../../lib/calculators/age';
  import { formatDate, inputDate, inputNumber, localTodayInput, number, setText, showError, showResult } from '../../lib/browser';
  const form = document.querySelector<HTMLFormElement>('#age-form');
  const baseInput = document.querySelector<HTMLInputElement>('#age-base-date');
  if (baseInput) baseInput.value = localTodayInput();
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const result = calculateAge(
        { year: inputNumber('birth-year', '생년'), month: inputNumber('birth-month', '생월'), day: inputNumber('birth-day', '생일') },
        inputDate('age-base-date', '기준일'),
      );
      setText('age-result', `만 ${result.age}세`);
      setText('age-days-lived', `${number.format(result.daysLived)}일`);
      setText('age-days-until', result.daysUntilBirthday === 0 ? '오늘' : `${number.format(result.daysUntilBirthday)}일`);
      setText('age-next-birthday', formatDate(result.nextBirthday));
      showResult('age-error', 'age-empty', 'age-content');
    } catch (error) { showError('age-error', error); }
  });
  form?.addEventListener('reset', () => setTimeout(() => { if (baseInput) baseInput.value = localTodayInput(); document.querySelector<HTMLElement>('#age-content')!.hidden = true; document.querySelector<HTMLElement>('#age-empty')!.hidden = false; setText('age-error', ''); }, 0));
</script>

