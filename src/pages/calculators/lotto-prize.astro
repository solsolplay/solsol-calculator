---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import { getCalculator } from '../../data/calculators';
import { sources } from '../../data/sources';
const calculator = getCalculator('lotto-prize');
---

<CalculatorLayout calculator={calculator}
  formula="총 당첨금이 200만 원 이하면 비과세, 그보다 크면 3억 원까지 22%, 3억 원 초과분에는 33%의 예상 원천징수율을 적용합니다."
  example="당첨금 5억 원이라면 3억 원에 22%, 나머지 2억 원에 33%를 적용해 예상 실수령액을 구합니다."
  caveats={["지방소득세 상당액을 포함한 단순 예상입니다.", "실제 지급·과세 기준은 수령 시점과 당첨 종류에 따라 다를 수 있습니다.", "공동구매·분할 수령 등 특수한 상황은 지급기관과 세무 전문가에게 확인하세요."]}
  sources={[sources.lotteryTaxFree, sources.lotteryTaxRates]} version="1.0.0">
  <section slot="form" class="calculator-panel"><h2>당첨금 입력</h2><form id="lotto-form" novalidate><div class="field-grid"><div class="field full"><label for="lotto-prize">총 당첨금(원)</label><input id="lotto-prize" type="number" min="0" step="1" value="1000000000" required /><small>발표된 세전 당첨금 전체를 입력하세요.</small></div></div><div class="quick-values" aria-label="금액 빠른 선택"><button type="button" data-prize="50000000">5천만 원</button><button type="button" data-prize="300000000">3억 원</button><button type="button" data-prize="1000000000">10억 원</button></div><div class="form-actions"><button class="button" type="submit">계산하기</button><button class="button secondary" type="reset">초기화</button></div><p id="lotto-error" class="error-message" role="alert"></p></form></section>
  <section slot="result" class="result-panel"><h2>계산 결과</h2><div id="lotto-empty" class="result-empty">당첨금을 입력하면 예상 세금과 실수령액을 보여드려요.</div><div id="lotto-content" class="result-content" hidden aria-live="polite"><div class="result-primary"><span class="label">예상 실수령액</span><strong id="lotto-result" data-testid="lotto-result"></strong></div><dl class="result-list"><div><dt>총 당첨금</dt><dd id="lotto-gross"></dd></div><div><dt>예상 세금</dt><dd id="lotto-tax"></dd></div><div><dt>실효세율</dt><dd id="lotto-rate"></dd></div></dl><p id="lotto-explanation" class="notice"></p></div></section>
</CalculatorLayout>

<script>
  import { calculateLottoPrize } from '../../lib/calculators/lotto';
  import { inputNumber, number, setText, showError, showResult, won } from '../../lib/browser';
  const prizeInput = document.querySelector<HTMLInputElement>('#lotto-prize');
  document.querySelectorAll<HTMLButtonElement>('[data-prize]').forEach((button) => button.addEventListener('click', () => { if (prizeInput) prizeInput.value = button.dataset.prize ?? ''; }));
  document.querySelector<HTMLFormElement>('#lotto-form')?.addEventListener('submit',(event)=>{event.preventDefault();try{const r=calculateLottoPrize(inputNumber('lotto-prize','당첨금'));setText('lotto-result',won.format(r.net));setText('lotto-gross',won.format(r.prize));setText('lotto-tax',won.format(r.tax));setText('lotto-rate',`${number.format(r.effectiveRate)}%`);setText('lotto-explanation',r.explanation);showResult('lotto-error','lotto-empty','lotto-content');}catch(error){showError('lotto-error',error);}});
</script>
<style>.quick-values{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.quick-values button{min-height:40px;padding:7px 12px;border:1px solid var(--border);border-radius:999px;color:var(--text);background:var(--surface);cursor:pointer}</style>

